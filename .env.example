DATABASE_URL="file:./dev.db"
ADMIN_PASSWORD="stampede-dev"
COUNT_SECRET="change-me-in-prod"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Vercel production: NEXT_PUBLIC_SITE_URL="https://stampede.codes"
# Prod: Turso. Runtime uses these. Prisma CLI still uses DATABASE_URL locally.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""
# HN Algolia needs no key. Weekly job hits hn.algolia.com.
# GitHub: PAT for repo search. On Actions, set repo secret GH_SEARCH_TOKEN (do not reuse a leaked PAT).
GITHUB_TOKEN=""
# Product Hunt developer token (GraphQL). Contact PH for commercial use.
PRODUCTHUNT_TOKEN=""
PRODUCTHUNT_API_KEY=""
PRODUCTHUNT_API_SECRET=""
PRODUCTHUNT_REDIRECT_URI="https://localhost"
TRUSTMRR_API_KEY=""
# Upwork official GraphQL (OAuth app). Job volume = Empty demand. No HTML scrape.
UPWORK_ACCESS_TOKEN=""
# DataForSEO Google Ads search volume. ESTIMATE demand, not builders.
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""
